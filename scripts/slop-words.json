      "id": "isnt-its",
      "level": "error",
      "regex": "\\b(?:isn't|is not|isn’t|aren't|aren’t|are not|wasn't|wasn’t)\\b[^.!?\\n]{0,60}?[;,:]\\s*(?:it's|it’s|it is|they're|they’re|they are|this is)\\b",
